# Kinpath production settings. Copy to .env.production (never commit it) or set these in your
# hosting platform's secret manager.

# Managed Postgres under a signed BAA. sslmode=require (or verify-full) is required.
DATABASE_URL=postgres://kinpath:CHANGE_ME@db.example.internal:5432/kinpath?sslmode=require
DATABASE_POOL_MAX=10

# Only these web origins may call the API from a browser (the phone app itself doesn't need CORS).
KINPATH_ALLOWED_ORIGINS=https://app.baysidefertility.example

# Never set these in production:
# KINPATH_DEV_LOGIN=1        (demo "pick a person" sign-in)
# KINPATH_SEED_DEMO=1        (synthetic demo data)
# KINPATH_INSECURE_COOKIES=1 (cookies over plain http)

# Later, when connected (each needs a signed BAA):
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=     (texts)
# PAUBOX_API_KEY= / PAUBOX_FROM=                               (email)
# ANTHROPIC_API_KEY=                                           (AI drafting, HIPAA-enabled org)

# Kinpath (Pumpkin) production settings. Copy to .env.production (never commit it) or set these in your
# hosting platform's secret manager.

# Managed Postgres under a signed BAA. sslmode=require (or verify-full) is required.
DATABASE_URL=postgres://kinpath:CHANGE_ME@db.example.internal:5432/kinpath?sslmode=require
DATABASE_POOL_MAX=10

# Only these web origins may call the API from a browser (the phone app itself doesn't need CORS).
KINPATH_ALLOWED_ORIGINS=https://bayside.thepumpkin.ai

# Never set these in production:
# KINPATH_DEV_LOGIN=1        (demo "pick a person" sign-in)
# KINPATH_SEED_DEMO=1        (synthetic demo data)
# KINPATH_INSECURE_COOKIES=1 (cookies over plain http)

# Later, when connected (each needs a signed BAA):
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=     (texts)
# PAUBOX_API_KEY= / PAUBOX_FROM=no-reply@thepumpkin.ai                             (email)
# KINPATH_AI_PROVIDER=anthropic / ANTHROPIC_API_KEY= / KINPATH_AI_BAA_SIGNED=1   (AI drafting, HIPAA-enabled org; see docs/AI.md)

# Records connection: encrypts Pumpkin's signing key for reading from a records system's FHIR API.
# 32 random bytes, base64 (openssl rand -base64 32). Keep it secret; changing it means setting up FHIR again.
# KINPATH_SECRET_KEY=
# How often to check the records system's FHIR API, in minutes (0 turns it off).
# KINPATH_FHIR_PULL_MINUTES=15

# Pumpkin on your own (docs/ON-YOUR-OWN.md)
# KINPATH_OPEN_SIGNUP=        # unset: only people let in from the waitlist; 1: anyone
# KINPATH_FREE_AI_READS=10   # free AI reads per month for people on their own
# KINPATH_INBOUND_SECRET=     # turns on forwarded email (shared with the inbound email service)
# KINPATH_INBOUND_DOMAIN=in.thepumpkin.ai

{
  "expo": {
    "name": "Pumpkin",
    "slug": "thepumpkin-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.thepumpkin.dev.patient",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSCalendarsWriteOnlyAccessUsageDescription": "Pumpkin adds the visits you choose to your calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.thepumpkin.dev.patient"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pumpkin uses Face ID to keep your record private."
        }
      ]
    ],
    "scheme": "pumpkin"
  }
}
